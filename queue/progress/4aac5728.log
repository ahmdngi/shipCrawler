{"event": "phase_output", "ts": 1781468531.3033984, "iso": "2026-06-14T20:22:11.303401+00:00", "phase": 0, "line": "**Risk Tier:** LOW \u2014 The vessel has effectively zero direct internet-facing attack surface. Risk factors are limited to operational OT exposure within Tallink's managed network and the generic threat landscape of Baltic Sea ferry operations.", "line_type": "output"}
{"event": "phase_output", "ts": 1781468531.3073149, "iso": "2026-06-14T20:22:11.307318+00:00", "phase": 0, "line": "---", "line_type": "output"}
