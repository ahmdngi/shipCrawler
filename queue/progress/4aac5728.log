{"event": "phase_output", "ts": 1781468510.8328106, "iso": "2026-06-14T20:21:50.832813+00:00", "phase": 0, "line": "**Risk Tier:** LOW \u2014 The vessel has effectively zero direct internet-facing attack surface. Risk factors are limited to operational OT exposure within Tallink's managed network and generic threat landscape of Baltic Sea ferry operations.", "line_type": "output"}
{"event": "phase_output", "ts": 1781468510.8369226, "iso": "2026-06-14T20:21:50.836925+00:00", "phase": 0, "line": "---", "line_type": "output"}
